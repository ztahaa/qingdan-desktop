{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "清单",
  "version": "1.0.0",
  "identifier": "com.qingdan.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "清单 · 本地待办",
        "width": 1280,
        "height": 800,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Qingdan",
    "shortDescription": "数据只保存在本机的待办事项应用",
    "longDescription": "清爽、快速、离线优先的待办事项桌面应用。所有任务、分类和备份均保存在用户自己的电脑上。",
    "category": "Productivity",
    "copyright": "Copyright © 2026 Qingdan",
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "languages": ["SimpChinese", "English"],
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
